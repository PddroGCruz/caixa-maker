<UserControl
    x:Class="CaixaMaker.App.Controls.Surface2DEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CmViewportCanvasBrush}"
    PreviewKeyDown="OnEditorPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Faixa superior acoplada única e compacta (28 px) -->
        <Border
            x:Name="HeaderStripBorder"
            Grid.Row="0"
            Height="28"
            Padding="4,0"
            Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Esquerda: abas das faces (Personalização/Isolado) OU cabeçalho Plano de Corte 1:1 (Fabricação) -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel
                        x:Name="EditingHeaderLeftPanel"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <StackPanel
                            x:Name="SurfaceTabsPanel"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center" />

                        <Border
                            x:Name="EditingDimsDivider"
                            Width="1"
                            Height="14"
                            Margin="1,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CmHairlineBorderBrush}" />

                        <TextBlock
                            x:Name="SurfaceDimensionsLabel"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                            Text="200×150mm" />
                    </StackPanel>

                    <StackPanel
                        x:Name="SheetHeaderLeftPanel"
                        Orientation="Horizontal"
                        Spacing="5"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Border
                            Height="20"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CmAccentSelectionBrush}"
                            BorderBrush="{ThemeResource CmAccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <TextBlock
                                x:Name="SheetHeaderTitleText"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CmMonoFontFamily}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmAccentHighlightBrush}"
                                Text="PLANO DE CORTE 1:1 (6 CHAPAS)" />
                        </Border>

                        <Button
                            x:Name="BtnSheetModeFull"
                            Height="20"
                            MinHeight="20"
                            Padding="5,0"
                            Click="OnSheetModeFullClick"
                            Content="Folha Completa"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource PrimaryAccentButtonStyle}" />

                        <Button
                            x:Name="BtnSheetModeSingle"
                            Height="20"
                            MinHeight="20"
                            Padding="5,0"
                            Click="OnSheetModeSingleClick"
                            Content="Chapa Isolada"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}" />

                        <Border
                            x:Name="SheetMetricsDivider"
                            Width="1"
                            Height="14"
                            Margin="1,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CmHairlineBorderBrush}" />

                        <TextBlock
                            x:Name="SheetMetricsLabel"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10"
                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                            Text="Folha: 432×401 mm" />
                    </StackPanel>
                </Grid>

                <!-- Centro: legendas compactas -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel
                        x:Name="LegendPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Área segura útil dentro das margens de segurança">
                            <Border Width="7" Height="7" Background="#22C55E" CornerRadius="1" />
                            <TextBlock
                                x:Name="SafeLegendText"
                                FontSize="9.5"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="Área segura" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Encaixes finger joint / furos estruturais restritos">
                            <Border Width="7" Height="7" Background="#EF4444" CornerRadius="1" />
                            <TextBlock
                                x:Name="RestrictedLegendText"
                                FontSize="9.5"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="Encaixes / Restrito" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="SheetLegendPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="#000000" BorderBrush="#64748B" BorderThickness="0.6" CornerRadius="1" />
                            <TextBlock x:Name="SheetExtLegendText" FontSize="9.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="Corte Ext." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="#B71C1C" CornerRadius="1" />
                            <TextBlock x:Name="SheetIntLegendText" FontSize="9.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="Interno" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="#38BDF8" CornerRadius="1" />
                            <TextBlock x:Name="SheetBedLegendText" FontSize="9.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="Mesa CNC" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Direita: coordenadas ao vivo + ações rápidas + Ajustar Vista -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button
                        x:Name="BtnReturnFullSheet"
                        Height="20"
                        MinHeight="20"
                        Padding="5,0"
                        Click="OnSheetModeFullClick"
                        Content="Ver Folha 1:1"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Alternar para o plano de corte completo 1:1"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="CursorCoordsText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10"
                        Foreground="{ThemeResource CmAccentHighlightBrush}"
                        Text="X:0 Y:0"
                        TextAlignment="Right" />

                    <Border
                        x:Name="CoordsDivider"
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CmHairlineBorderBrush}" />

                    <StackPanel
                        x:Name="SelectionActionsPanel"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button
                            Height="20"
                            MinHeight="20"
                            Padding="4,0"
                            Click="OnCenterSelectionClick"
                            Content="Centralizar"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            ToolTipService.ToolTip="Centralizar elemento na área segura" />
                        <Button
                            Height="20"
                            MinHeight="20"
                            Padding="4,0"
                            Click="OnRotate90Click"
                            Content="90°"
                            CornerRadius="2"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            ToolTipService.ToolTip="Girar elemento selecionado em +90°" />
                        <Button
                            Height="20"
                            MinHeight="20"
                            Padding="4,0"
                            Click="OnDuplicateSelectionClick"
                            Content="Duplicar"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            ToolTipService.ToolTip="Duplicar elemento (Ctrl+D)" />
                        <Button
                            Height="20"
                            MinHeight="20"
                            Padding="4,0"
                            Click="OnDeleteSelectionClick"
                            Content="Excluir"
                            CornerRadius="2"
                            FontSize="10"
                            Foreground="{ThemeResource CmStatusDangerBrush}"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            ToolTipService.ToolTip="Excluir elemento selecionado (Delete)" />
                    </StackPanel>

                    <StackPanel
                        x:Name="SplitLayoutButtonsPanel"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Border
                            Width="1"
                            Height="14"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CmHairlineBorderBrush}" />
                        <Button
                            x:Name="BtnSplitVertical"
                            Height="20"
                            MinHeight="20"
                            Padding="5,0"
                            Click="OnSplitOrientationClick"
                            Content="⬒ Vert"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            Tag="VerticalStacked"
                            ToolTipService.ToolTip="Divisão vertical (3D em cima, 2D embaixo)" />
                        <Button
                            x:Name="BtnSplitHorizontal"
                            Height="20"
                            MinHeight="20"
                            Padding="5,0"
                            Click="OnSplitOrientationClick"
                            Content="◫ Lado"
                            CornerRadius="2"
                            FontSize="10"
                            Style="{StaticResource CompactToolbarButtonStyle}"
                            Tag="HorizontalSideBySide"
                            ToolTipService.ToolTip="Divisão lado a lado (3D à esquerda, 2D à direita)" />
                    </StackPanel>

                    <Button
                        x:Name="BtnFitZoom"
                        Height="20"
                        MinHeight="20"
                        Padding="5,0"
                        Click="OnFitZoomClick"
                        Content="Ajustar Vista"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Enquadrar a face ativa (100%)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Barra de ferramentas CAD 2D (desenho click-and-drag 1:1) -->
        <Border
            x:Name="DrawToolStripBorder"
            Grid.Row="1"
            Height="26"
            Padding="6,0"
            Background="{ThemeResource CmElevatedSurfaceBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="ToolSelectBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="⌖ Selecionar (V)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource PrimaryAccentButtonStyle}"
                        Tag="Select"
                        ToolTipService.ToolTip="Selecionar, mover e redimensionar elementos (V)" />
                    <Button
                        x:Name="ToolDrawRectBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="▭ Retângulo (R)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="DrawRectangle"
                        ToolTipService.ToolTip="Desenhar retângulo por arraste 1:1 (R)" />
                    <Button
                        x:Name="ToolDrawCircleBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="◯ Círculo (C)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="DrawCircle"
                        ToolTipService.ToolTip="Desenhar círculo / furo por arraste 1:1 (C)" />
                    <Button
                        x:Name="ToolDrawSlotBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="⬭ Oblongo (S)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="DrawSlot"
                        ToolTipService.ToolTip="Desenhar oblongo / slot por arraste 1:1 (S)" />
                    <Button
                        x:Name="ToolDrawPolyBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="⬡ Polígono (P)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="DrawPolygon"
                        ToolTipService.ToolTip="Desenhar polígono regular por arraste 1:1 (P)" />
                    <Button
                        x:Name="ToolDrawCrossBtn"
                        Height="20"
                        MinHeight="20"
                        Padding="6,0"
                        Click="OnDrawToolClick"
                        Content="⊕ Cruz (X)"
                        CornerRadius="2"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="DrawCrosshair"
                        ToolTipService.ToolTip="Desenhar cruz de centro de furação (X)" />
                </StackPanel>

                <TextBlock
                    x:Name="DrawToolHintText"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="9.5"
                    Foreground="{ThemeResource CmTextMutedBrush}"
                    Text="Clique ou arraste na chapa • Shift: quadrado • Alt: centro • Esc: cancelar"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Row 2: Canvas CAD 2D milimétrico com réguas graduadas (18 px topo/esquerda) -->
        <Grid
            x:Name="CanvasHost"
            Grid.Row="2"
            Background="{ThemeResource CmViewportCanvasBrush}"
            ContextRequested="OnCanvasContextRequested"
            IsTabStop="True"
            PointerCanceled="OnCanvasPointerLost"
            PointerCaptureLost="OnCanvasPointerLost"
            PointerExited="OnCanvasPointerExited"
            PointerMoved="OnCanvasPointerMoved"
            PointerPressed="OnCanvasPointerPressed"
            PointerReleased="OnCanvasPointerReleased"
            PointerWheelChanged="OnCanvasPointerWheelChanged">
            <Grid.ContextFlyout>
                <MenuFlyout Opening="OnContextMenuOpening">
                    <MenuFlyoutItem x:Name="CtxCenterItem" Click="OnCenterSelectionClick" Text="Centralizar na face" />
                    <MenuFlyoutItem x:Name="CtxRotate90Item" Click="OnRotate90Click" Text="Girar +90°" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="CtxCopyItem" Click="OnContextCopyClick" Text="Copiar" />
                    <MenuFlyoutItem x:Name="CtxPasteItem" Click="OnContextPasteClick" Text="Colar na face" />
                    <MenuFlyoutItem x:Name="CtxDuplicateItem" Click="OnDuplicateSelectionClick" Text="Duplicar" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="CtxDeleteItem" Click="OnDeleteSelectionClick" Text="Excluir" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnFitZoomClick" Text="Ajustar visualização (100%)" />
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Image x:Name="CanvasImage" Stretch="Fill" />
        </Grid>
    </Grid>
</UserControl>
