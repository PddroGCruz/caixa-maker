<UserControl
    x:Class="CaixaMaker.App.Controls.BoxViewer3DControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource CmViewportCanvasBrush}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#16A34A" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#15803D" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#14532D" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#16A34A" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#16A34A" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#22C55E" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#15803D" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#16A34A" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#22C55E" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- Viewport 3D nativo via SkiaSharp + Z-Buffer com chapas extrudadas e gravações CNC -->
        <Grid
            x:Name="CanvasHost"
            Background="{ThemeResource CmViewportCanvasBrush}"
            PointerCanceled="OnViewportPointerLost"
            PointerCaptureLost="OnViewportPointerLost"
            PointerExited="OnViewportPointerExited"
            PointerMoved="OnViewportPointerMoved"
            PointerPressed="OnViewportPointerPressed"
            PointerReleased="OnViewportPointerReleased"
            PointerWheelChanged="OnViewportPointerWheelChanged">
            <Image
                x:Name="RenderImage"
                Stretch="Fill" />
        </Grid>

        <!-- HUD Superior Esquerdo: Gizmo XYZ 54x54 + Pílula técnica compacta -->
        <StackPanel
            Margin="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Orientation="Horizontal"
            Spacing="6">
            <Grid CornerRadius="3">
                <Border
                    Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Opacity="0.90" />
                <Image
                    x:Name="AxisGizmoImage"
                    Width="54"
                    Height="54"
                    Margin="2"
                    Stretch="Fill" />
            </Grid>

            <Grid
                x:Name="HudPrimaryPill"
                Height="26"
                VerticalAlignment="Top"
                CornerRadius="3">
                <Border
                    Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Opacity="0.90" />
                <StackPanel
                    Margin="8,0"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Ellipse
                        x:Name="ActiveFaceDot"
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource CmAccentHighlightBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HudPrimaryPillText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CmTextPrimaryBrush}"
                        Text="PEÇA: Todas • ESCALA 1:1" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- HUD Superior Direito: Câmera e alternância de modo na Personalização -->
        <StackPanel
            Margin="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Spacing="4">
            <Grid Height="26" HorizontalAlignment="Right" CornerRadius="3">
                <Border
                    Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Opacity="0.90" />
                <StackPanel Margin="2,0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BtnIso" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="ISO" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Isometric" />
                    <Button x:Name="BtnFront" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="Frente" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Front" />
                    <Button x:Name="BtnBack" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="Trás" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Back" />
                    <Button x:Name="BtnLeft" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="Esq" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Left" />
                    <Button x:Name="BtnRight" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="Dir" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Right" />
                    <Button x:Name="BtnTop" Height="22" MinHeight="22" Padding="6,0" Click="OnCameraPresetClick" Content="Topo" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Top" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="PersonalizationViewModesPanel"
                Height="26"
                HorizontalAlignment="Right"
                CornerRadius="3"
                Visibility="Collapsed">
                <Border
                    Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Opacity="0.90" />
                <StackPanel Margin="2,0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BtnViewMode3D" Height="22" MinHeight="22" Padding="7,0" Click="OnViewModeClick" Content="Vista 3D" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Mode3D" />
                    <Button x:Name="BtnViewModeSplit" Height="22" MinHeight="22" Padding="7,0" Click="OnViewModeClick" Content="3D + 2D" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Split" />
                    <Button x:Name="BtnViewMode2D" Height="22" MinHeight="22" Padding="7,0" Click="OnViewModeClick" Content="Editor 2D" CornerRadius="2" FontSize="10.5" Style="{StaticResource CompactToolbarButtonStyle}" Tag="Mode2D" />
                    <Border
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        Background="{ThemeResource CmHairlineBorderBrush}" />
                    <Button
                        x:Name="BtnSplitVertical"
                        Height="22"
                        MinHeight="22"
                        Padding="6,0"
                        Click="OnSplitOrientationClick"
                        Content="⬒ Vert"
                        CornerRadius="2"
                        FontSize="10.5"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="VerticalStacked"
                        ToolTipService.ToolTip="Divisão vertical (3D em cima, 2D embaixo)" />
                    <Button
                        x:Name="BtnSplitHorizontal"
                        Height="22"
                        MinHeight="22"
                        Padding="6,0"
                        Click="OnSplitOrientationClick"
                        Content="◫ Lado"
                        CornerRadius="2"
                        FontSize="10.5"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="HorizontalSideBySide"
                        ToolTipService.ToolTip="Divisão lado a lado (3D à esquerda, 2D à direita)" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- HUD Flutuante Inferior Central: Tampa (0°/90°), vista explodida, cotas 3D e resetar -->
        <Grid
            Height="28"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            CornerRadius="3">
            <Border
                Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Opacity="0.90" />
            <StackPanel Margin="8,2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <StackPanel
                    x:Name="LidHudPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="LidToggleButton"
                        Height="22"
                        MinHeight="22"
                        Padding="6,0"
                        Click="OnLidToggleClick"
                        Content="Tampa: 35°"
                        CornerRadius="2"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Abrir ou fechar a tampa (Alt+D)" />
                    <Slider
                        x:Name="LidAngleSlider"
                        Width="80"
                        VerticalAlignment="Center"
                        Maximum="110"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnLidSliderValueChanged" />
                    <Button
                        x:Name="BtnLid0"
                        Height="20"
                        MinHeight="20"
                        Padding="5,0"
                        Click="OnLidPresetClick"
                        Content="0°"
                        CornerRadius="2"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="0"
                        ToolTipService.ToolTip="Fechar tampa (0°)" />
                    <Button
                        x:Name="BtnLid90"
                        Height="20"
                        MinHeight="20"
                        Padding="5,0"
                        Click="OnLidPresetClick"
                        Content="90°"
                        CornerRadius="2"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        Tag="90"
                        ToolTipService.ToolTip="Abrir tampa a 90°" />
                    <Border
                        Width="1"
                        Height="16"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CmHairlineBorderBrush}" />
                </StackPanel>

                <ToggleButton
                    x:Name="ExplodeToggle"
                    Height="22"
                    MinHeight="22"
                    Padding="7,0"
                    Click="OnExplodeToggleClick"
                    Content="Peças separadas"
                    CornerRadius="2"
                    FontSize="10.5"
                    ToolTipService.ToolTip="Separar chapas na vista explodida (Alt+E)" />

                <ToggleButton
                    x:Name="DimensionsToggle"
                    Height="22"
                    MinHeight="22"
                    Padding="7,0"
                    Click="OnDimensionsToggleClick"
                    Content="Cotas 3D"
                    CornerRadius="2"
                    FontSize="10.5"
                    ToolTipService.ToolTip="Exibir ou ocultar cotas tridimensionais" />

                <Border
                    Width="1"
                    Height="16"
                    Margin="1,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CmHairlineBorderBrush}" />

                <Button
                    x:Name="BtnResetCamera"
                    Height="22"
                    MinHeight="22"
                    Padding="7,0"
                    Click="OnResetCameraClick"
                    Content="Resetar"
                    CornerRadius="2"
                    FontSize="10.5"
                    Style="{StaticResource CompactToolbarButtonStyle}"
                    ToolTipService.ToolTip="Restaurar câmera isométrica (Ctrl+R)" />
            </StackPanel>
        </Grid>

        <!-- Editor flutuante inline para cotas 3D clicáveis (Enter aplica, Tab alterna eixo, Esc cancela) -->
        <Border
            x:Name="InlineDimensionEditorOverlay"
            Width="216"
            Padding="8,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource CmElevatedSurfaceBrush}"
            BorderBrush="{ThemeResource CmAccentPrimaryBrush}"
            BorderThickness="1.5"
            CornerRadius="4"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InlineDimensionOverlayTransform" />
            </Border.RenderTransform>
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="InlineDimHeaderText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CmAccentHighlightBrush}"
                        Text="LARGURA (X) • EXTERNA (MM)"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="InlineDimCloseBtn"
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        MinWidth="18"
                        MinHeight="18"
                        Padding="0"
                        Click="OnInlineDimCloseClick"
                        Content="✕"
                        FontSize="9.5"
                        IsTabStop="False"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Cancelar edição inline (Esc)" />
                </Grid>

                <TextBox
                    x:Name="InlineDimTextBox"
                    Height="28"
                    MinHeight="0"
                    Padding="7,0"
                    FontFamily="{StaticResource CmMonoFontFamily}"
                    FontSize="12"
                    LostFocus="OnInlineDimLostFocus"
                    PlaceholderText="Ex.: 200 ou 200 + 15"
                    PreviewKeyDown="OnInlineDimPreviewKeyDown"
                    Style="{StaticResource CadTextBoxStyle}"
                    TextChanged="OnInlineDimTextChanged" />

                <TextBlock
                    x:Name="InlineDimErrorText"
                    FontSize="10"
                    Foreground="{ThemeResource CmStatusDangerBrush}"
                    Text="Expressão inválida ou ≤ 0 mm"
                    Visibility="Collapsed" />

                <TextBlock
                    FontSize="9.5"
                    Foreground="{ThemeResource CmTextMutedBrush}"
                    Text="Enter: aplicar • Tab: próx. cota • Esc: cancelar" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
