<UserControl
    x:Class="CaixaMaker.App.Controls.CadPrimitives.CadPropertyRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid MinHeight="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="0,2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LabelColumn" Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="LabelTouchArea"
                Grid.Column="0"
                Background="Transparent"
                PointerCaptureLost="OnLabelPointerLost"
                PointerEntered="OnLabelPointerEntered"
                PointerExited="OnLabelPointerExited"
                PointerMoved="OnLabelPointerMoved"
                PointerPressed="OnLabelPointerPressed"
                PointerReleased="OnLabelPointerReleased">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        x:Name="LabelTextBlock"
                        Style="{StaticResource CadPropertyLabelStyle}"
                        Text="Propriedade" />
                    <Border
                        x:Name="InfoBadge"
                        Width="13"
                        Height="13"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource CmSubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="9"
                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                            Text="?" />
                    </Border>
                </StackPanel>
            </Grid>

            <ContentPresenter
                x:Name="EditorPresenter"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center" />
        </Grid>

        <Rectangle
            x:Name="BottomDivider"
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource CmHairlineBorderBrush}"
            Opacity="0.55" />
    </Grid>
</UserControl>
