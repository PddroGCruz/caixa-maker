<UserControl
    x:Class="CaixaMaker.App.Controls.CadPrimitives.CadMetricTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{ThemeResource CmPanelBackgroundBrush}"
        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CmControlCornerRadius}">
        <StackPanel x:Name="RowsStack" Spacing="0" />
    </Border>
</UserControl>
