<UserControl
    x:Class="CaixaMaker.App.Controls.SplashScreenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="680"
    Height="380"
    RequestedTheme="Dark">

    <Border
        Width="680"
        Height="380"
        Background="#0B0E14"
        BorderBrush="#1E2634"
        BorderThickness="1">
        <Grid>
            <!-- Fundo Arquitetônico Minimalista (Grafite-Ardósia + Glow Difuso + Marca d'Água Geométrica) -->
            <Image
                x:Name="HeroArtworkImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Fill" />

            <!-- Estrutura Editorial Limpa com Amplo Espaço Negativo -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Bloco Central Principal (Identidade Pura do Caixa Maker) -->
                <StackPanel
                    Grid.Row="0"
                    Margin="42,24,42,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="20">
                    <!-- Container do Símbolo Oficial -->
                    <Border
                        Width="92"
                        Height="92"
                        VerticalAlignment="Center"
                        Background="#131924"
                        BorderBrush="#4022C55E"
                        BorderThickness="1"
                        CornerRadius="18">
                        <Image
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/caixa-maker-symbol.png"
                            Stretch="Uniform" />
                    </Border>

                    <!-- Wordmark Bi-Peso + Badge Discreto + Subtítulo em 1 Linha -->
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                CharacterSpacing="40"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#F8FAFC"
                                Text="CAIXA" />
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="40"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="36"
                                FontWeight="Light"
                                Foreground="#22C55E"
                                Text="MAKER" />
                            <Border
                                Margin="12,2,0,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="#14291E"
                                BorderBrush="#5522C55E"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    x:Name="VersionBadgeTextBlock"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#4ADE80"
                                    Text="v2.3.0" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            CharacterSpacing="15"
                            FontFamily="{StaticResource CmUiFontFamily}"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Text="Modelagem Paramétrica e Fabricação Digital" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Rodapé Minimalista (Linha Divisória Fina + Status + Créditos + Percentual) -->
                <StackPanel
                    Grid.Row="1"
                    Padding="42,0,42,16"
                    VerticalAlignment="Bottom"
                    Spacing="14">
                    <Border Height="1" Background="#1E2634" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                x:Name="StatusStepTextBlock"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11.5"
                                Foreground="#CBD5E1"
                                Text="Inicializando plataforma CAD/CAM..."
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="10.5"
                                Foreground="#64748B"
                                Text="Laboratório IFMaker do Juruá • IFAC Cruzeiro do Sul  |  Pedro G. Cruz (PddroGCruz)"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="ProgressPercentTextBlock"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#22C55E"
                            Text="0%" />
                    </Grid>
                </StackPanel>

                <!-- 3. Barra de Progresso Contínua na Borda Inferior -->
                <Border
                    x:Name="ProgressTrackBorder"
                    Grid.Row="2"
                    Height="3"
                    HorizontalAlignment="Stretch"
                    Background="#161D2A">
                    <Border
                        x:Name="ProgressFillBar"
                        Width="0"
                        Height="3"
                        HorizontalAlignment="Left"
                        Background="#22C55E" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
