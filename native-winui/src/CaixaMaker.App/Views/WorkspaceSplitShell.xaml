<UserControl
    x:Class="CaixaMaker.App.Views.WorkspaceSplitShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:areas="using:CaixaMaker.App.Views.Areas"
    xmlns:controls="using:CaixaMaker.App.Controls"
    xmlns:primitives="using:CaixaMaker.App.Controls.CadPrimitives"
    Background="{ThemeResource CmViewportCanvasBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Barra Superior de Engenharia (34 px) -->
        <Border
            Grid.Row="0"
            Height="34"
            Padding="8,0"
            Background="{ThemeResource CmShellBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Esquerda: ← Início + Marca + Projeto/Dimensões + Não salvo -->
                <Grid Grid.Column="0" VerticalAlignment="Center" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Height="24"
                        MinHeight="24"
                        Padding="8,0"
                        Click="OnBackToCatalogClick"
                        Content="← Início"
                        FontSize="11.5"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Voltar ao Catálogo Inicial (Ctrl+Shift+H)" />

                    <Rectangle
                        Grid.Column="1"
                        Width="1"
                        Height="16"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5">
                        <Image
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/caixa-maker-symbol.png"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmUiFontFamily}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                            Text="Caixa Maker" />
                    </StackPanel>

                    <Grid
                        Grid.Column="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            Grid.Column="0"
                            Width="1"
                            Height="14"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource CmHairlineBorderBrush}" />
                        <TextBlock
                            x:Name="WorkspaceHeaderProjectTextBlock"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                            Text="Caixa com Tampa e Alças [200×150×100 mm • MDF 3 mm]"
                            TextTrimming="CharacterEllipsis" />
                        <primitives:CadStatusBadge
                            x:Name="UnsavedStatusBadge"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Kind="Dirty"
                            Text="Não salvo *"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Centro estilo Fusion 360: Seletor de Área de Trabalho (1→2→3) + Acesso Independente ao Otimizador -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        Height="26"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CmViewportCanvasBrush}"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CmControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="TabModelingBtn"
                            Height="20"
                            MinWidth="0"
                            MinHeight="20"
                            Padding="8,0"
                            BorderThickness="1"
                            Click="OnAreaTabClick"
                            CornerRadius="{StaticResource CmControlCornerRadius}"
                            Tag="Modeling"
                            ToolTipService.ToolTip="Etapa 1: Modelagem Paramétrica 1:1 (Alt+1)">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    x:Name="TabModelingStepBadge"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="TabModelingStepText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmMonoFontFamily}"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Text="1" />
                                </Border>
                                <TextBlock
                                    x:Name="TabModelingText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="11.5"
                                    Text="Modelagem" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="StepperConnector12"
                            Margin="1,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                            Opacity="0.65"
                            Text="→" />

                        <Button
                            x:Name="TabPersonalizationBtn"
                            Height="20"
                            MinWidth="0"
                            MinHeight="20"
                            Padding="8,0"
                            BorderThickness="1"
                            Click="OnAreaTabClick"
                            CornerRadius="{StaticResource CmControlCornerRadius}"
                            Tag="Personalization"
                            ToolTipService.ToolTip="Etapa 2: Personalização CNC (Alt+2)">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    x:Name="TabPersonalizationStepBadge"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="TabPersonalizationStepText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmMonoFontFamily}"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Text="2" />
                                </Border>
                                <TextBlock
                                    x:Name="TabPersonalizationText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="11.5"
                                    Text="Personalização" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="StepperConnector23"
                            Margin="1,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                            Opacity="0.65"
                            Text="→" />

                        <Button
                            x:Name="TabFabricationBtn"
                            Height="20"
                            MinWidth="0"
                            MinHeight="20"
                            Padding="8,0"
                            BorderThickness="1"
                            Click="OnAreaTabClick"
                            CornerRadius="{StaticResource CmControlCornerRadius}"
                            Tag="Fabrication"
                            ToolTipService.ToolTip="Etapa 3: Fabricação e Exportação CAM (Alt+3)">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    x:Name="TabFabricationStepBadge"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="TabFabricationStepText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmMonoFontFamily}"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        Text="3" />
                                </Border>
                                <TextBlock
                                    x:Name="TabFabricationText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="11.5"
                                    Text="Fabricação" />
                            </StackPanel>
                        </Button>

                        <Rectangle
                            Width="1"
                            Height="14"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource CmHairlineBorderBrush}" />

                        <TextBlock
                            Margin="3,0,4,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10"
                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                            Opacity="0.8"
                            Text="Alt+1..3" />
                        </StackPanel>
                    </Border>

                    <Rectangle
                        Width="1"
                        Height="16"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <Button
                        x:Name="HeaderOpenNestingBtn"
                        Height="26"
                        MinWidth="0"
                        MinHeight="26"
                        Padding="9,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CmAccentSelectionBrush}"
                        BorderBrush="{ThemeResource CmAccentHighlightBrush}"
                        BorderThickness="1"
                        Click="OnOpenNestingHeaderClick"
                        CornerRadius="{StaticResource CmControlCornerRadius}"
                        Style="{StaticResource CadSecondaryButtonStyle}"
                        ToolTipService.ToolTip="Abrir Otimizador de Corte 2D (SVG / DXF / Nesting) — Alt+4">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="11"
                                Foreground="{ThemeResource CmAccentHighlightBrush}"
                                Glyph="&#xE80A;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmAccentHighlightBrush}"
                                Text="Otimizador" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Direita: Status CNC + Tema + Preferências + Sobre -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <primitives:CadStatusBadge
                        x:Name="TopCncStatusBadge"
                        VerticalAlignment="Center"
                        Kind="Valid"
                        Text="CNC OK" />

                    <controls:CadThemeSwitcher x:Name="HeaderThemeSwitcher" VerticalAlignment="Center" />

                    <Button
                        Height="24"
                        MinHeight="24"
                        Padding="8,0"
                        Click="OnOpenPreferencesClick"
                        Content="Preferências"
                        FontSize="11.5"
                        Style="{StaticResource CadSecondaryButtonStyle}"
                        ToolTipService.ToolTip="Preferências de interface e CAM" />

                    <Button
                        Height="24"
                        MinHeight="24"
                        Padding="8,0"
                        Click="OnOpenAboutClick"
                        Content="Sobre"
                        FontSize="11.5"
                        Style="{StaticResource CompactToolbarButtonStyle}"
                        ToolTipService.ToolTip="Sobre o Caixa Maker e Identidade Institucional (F1)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Ribbon Contextual Estilo Fusion 360 (48 px) -->
        <Border
            x:Name="CadToolbarBorder"
            Grid.Row="1"
            Height="48"
            Padding="8,0"
            Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Coluna Esquerda: Grupos Fixos (ARQUIVO, HISTÓRICO) + Grupos Contextuais da Área Ativa -->
                <ScrollViewer
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="0">

                        <!-- Grupo Fixo 1: ARQUIVO -->
                        <primitives:CadToolbarGroup GroupLabel="ARQUIVO" ShowSeparator="False">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <primitives:CadToolbarButton
                                    x:Name="NewToolbarBtn"
                                    Click="OnNewProjectClick"
                                    Glyph="&#xE8A5;"
                                    Label="Novo Projeto"
                                    Shortcut="Ctrl+N" />
                                <primitives:CadToolbarButton
                                    x:Name="OpenToolbarBtn"
                                    Click="OnOpenProjectClick"
                                    Glyph="&#xE8E5;"
                                    Label="Abrir Projeto"
                                    Shortcut="Ctrl+O" />
                                <primitives:CadToolbarButton
                                    x:Name="SaveToolbarBtn"
                                    Click="OnSaveClick"
                                    Glyph="&#xE74E;"
                                    Label="Salvar Projeto"
                                    Shortcut="Ctrl+S" />
                                <primitives:CadToolbarButton
                                    x:Name="ImportPkgToolbarBtn"
                                    Click="OnImportPackageClick"
                                    Glyph="&#xE896;"
                                    Label="Importar Pacote"
                                    Shortcut="Ctrl+Shift+O" />
                                <primitives:CadToolbarButton
                                    x:Name="ExportPkgToolbarBtn"
                                    Click="OnExportPackageClick"
                                    Glyph="&#xE898;"
                                    Label="Exportar Pacote"
                                    Shortcut="Ctrl+Shift+S" />
                            </StackPanel>
                        </primitives:CadToolbarGroup>

                        <!-- Grupo Fixo 2: HISTÓRICO -->
                        <primitives:CadToolbarGroup GroupLabel="HISTÓRICO" ShowSeparator="True">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <primitives:CadToolbarButton
                                    x:Name="UndoToolbarBtn"
                                    Click="OnUndoClick"
                                    Glyph="&#xE7A7;"
                                    Label="Desfazer"
                                    Shortcut="Ctrl+Z" />
                                <primitives:CadToolbarButton
                                    x:Name="RedoToolbarBtn"
                                    Click="OnRedoClick"
                                    Glyph="&#xE7A6;"
                                    Label="Refazer"
                                    Shortcut="Ctrl+Y" />
                            </StackPanel>
                        </primitives:CadToolbarGroup>

                        <!-- Grupos Contextuais 1: ÁREA DE MODELAGEM -->
                        <StackPanel
                            x:Name="ModelingRibbonGroups"
                            Orientation="Horizontal"
                            Spacing="0">
                            <primitives:CadToolbarGroup GroupLabel="REFERÊNCIA DIM." ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="ExternalDimToolbarBtn"
                                        Click="OnExternalDimModeClick"
                                        Glyph="&#xE740;"
                                        Label="Externa"
                                        Shortcut="Dimensões Externas Totais"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="InternalDimToolbarBtn"
                                        Click="OnInternalDimModeClick"
                                        Glyph="&#xE73F;"
                                        Label="Interna"
                                        Shortcut="Dimensões Internas Úteis"
                                        ShowLabel="True" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="MDF RÁPIDO" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="Mdf3ToolbarBtn"
                                        Click="OnQuickThicknessClick"
                                        Glyph=""
                                        Label="3mm"
                                        Shortcut="Espessura MDF 3.0 mm"
                                        ShowLabel="True"
                                        Tag="3.0" />
                                    <primitives:CadToolbarButton
                                        x:Name="Mdf4ToolbarBtn"
                                        Click="OnQuickThicknessClick"
                                        Glyph=""
                                        Label="4mm"
                                        Shortcut="Espessura MDF 4.0 mm"
                                        ShowLabel="True"
                                        Tag="4.0" />
                                    <primitives:CadToolbarButton
                                        x:Name="Mdf6ToolbarBtn"
                                        Click="OnQuickThicknessClick"
                                        Glyph=""
                                        Label="6mm"
                                        Shortcut="Espessura MDF 6.0 mm"
                                        ShowLabel="True"
                                        Tag="6.0" />
                                    <primitives:CadToolbarButton
                                        x:Name="Mdf9ToolbarBtn"
                                        Click="OnQuickThicknessClick"
                                        Glyph=""
                                        Label="9mm"
                                        Shortcut="Espessura MDF 9.0 mm"
                                        ShowLabel="True"
                                        Tag="9.0" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="INSPEÇÃO 3D" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="ResetCameraToolbarBtn"
                                        Click="OnResetCameraClick"
                                        Glyph="&#xE72C;"
                                        Label="Resetar Câmera"
                                        Shortcut="ISO" />
                                    <primitives:CadToolbarButton
                                        x:Name="ExplodeToolbarBtn"
                                        Click="OnExplodeClick"
                                        Glyph="&#xF158;"
                                        Label="Explodir"
                                        Shortcut="Peças Separadas 3D"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="DimensionsToolbarBtn"
                                        Click="OnToggleDimensionsClick"
                                        Glyph="&#xE909;"
                                        Label="Cotas 3D"
                                        Shortcut="Cotas e medidas no 3D"
                                        ShowLabel="True" />
                                    <Rectangle
                                        Width="1"
                                        Height="16"
                                        Margin="2,0"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CmHairlineBorderBrush}" />
                                    <primitives:CadToolbarButton
                                        x:Name="Lid0ToolbarBtn"
                                        Click="OnQuickLidAngleClick"
                                        Glyph=""
                                        Label="0°"
                                        Shortcut="Tampa Fechada (0°)"
                                        ShowLabel="True"
                                        Tag="0" />
                                    <primitives:CadToolbarButton
                                        x:Name="Lid45ToolbarBtn"
                                        Click="OnQuickLidAngleClick"
                                        Glyph=""
                                        Label="45°"
                                        Shortcut="Tampa Semiaberta (45°)"
                                        ShowLabel="True"
                                        Tag="45" />
                                    <primitives:CadToolbarButton
                                        x:Name="Lid90ToolbarBtn"
                                        Click="OnQuickLidAngleClick"
                                        Glyph=""
                                        Label="90°"
                                        Shortcut="Tampa Aberta (90°)"
                                        ShowLabel="True"
                                        Tag="90" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="CALIBRAÇÃO" ShowSeparator="True">
                                <primitives:CadToolbarButton
                                    x:Name="KerfModelingToolbarBtn"
                                    Click="OnExportKerfSvgClick"
                                    Glyph="&#xE909;"
                                    Label="Pente Kerf"
                                    Shortcut="Escolher local e formato (SVG/DXF/PDF)"
                                    ShowLabel="True" />
                            </primitives:CadToolbarGroup>
                        </StackPanel>

                        <!-- Grupos Contextuais 2: ÁREA DE PERSONALIZAÇÃO CAM -->
                        <StackPanel
                            x:Name="PersonalizationRibbonGroups"
                            Orientation="Horizontal"
                            Spacing="0"
                            Visibility="Collapsed">
                            <primitives:CadToolbarGroup
                                x:Name="CamContextToolbarGroup"
                                GroupLabel="INSERIR CAM"
                                ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="AddTextToolbarBtn"
                                        Click="OnAddTextClick"
                                        Glyph="&#xE8D2;"
                                        IsPrimary="True"
                                        Label="+ Texto"
                                        Shortcut="T"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="AddSvgToolbarBtn"
                                        Click="OnAddSvgClick"
                                        Glyph="&#xE932;"
                                        Label="+ SVG"
                                        Shortcut="Ctrl+Shift+I"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="AddRasterToolbarBtn"
                                        Click="OnAddRasterClick"
                                        Glyph="&#xEB9F;"
                                        Label="+ Imagem"
                                        Shortcut="Ctrl+I"
                                        ShowLabel="True" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="POSICIONAR NA FACE" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="CenterToolbarBtn"
                                        Click="OnCenterSelectedClick"
                                        Glyph="&#xE8E3;"
                                        Label="Centralizar na superfície" />
                                    <primitives:CadToolbarButton
                                        x:Name="AlignLeftToolbarBtn"
                                        Click="OnAlignLeftClick"
                                        Glyph="&#xE8E4;"
                                        Label="Alinhar à esquerda" />
                                    <primitives:CadToolbarButton
                                        x:Name="AlignRightToolbarBtn"
                                        Click="OnAlignRightClick"
                                        Glyph="&#xE8E2;"
                                        Label="Alinhar à direita" />
                                    <primitives:CadToolbarButton
                                        x:Name="AlignTopToolbarBtn"
                                        Click="OnAlignTopClick"
                                        Glyph="&#xE74A;"
                                        Label="Alinhar ao topo" />
                                    <primitives:CadToolbarButton
                                        x:Name="AlignBottomToolbarBtn"
                                        Click="OnAlignBottomClick"
                                        Glyph="&#xE74B;"
                                        Label="Alinhar à base" />
                                    <primitives:CadToolbarButton
                                        x:Name="Rotate90ToolbarBtn"
                                        Click="OnRotate90Click"
                                        Glyph=""
                                        Label="90°"
                                        Shortcut="Girar +90°"
                                        ShowLabel="True" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="EDIÇÃO CAM" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="CopyToolbarBtn"
                                        Click="OnCopyClick"
                                        Glyph="&#xE8C8;"
                                        Label="Copiar"
                                        Shortcut="Ctrl+C" />
                                    <primitives:CadToolbarButton
                                        x:Name="PasteToolbarBtn"
                                        Click="OnPasteClick"
                                        Glyph="&#xE77F;"
                                        Label="Colar"
                                        Shortcut="Ctrl+V" />
                                    <primitives:CadToolbarButton
                                        x:Name="DuplicateToolbarBtn"
                                        Click="OnDuplicateClick"
                                        Glyph="2×"
                                        Label="Duplicar"
                                        Shortcut="Ctrl+D" />
                                    <primitives:CadToolbarButton
                                        x:Name="DeleteToolbarBtn"
                                        Click="OnDeleteClick"
                                        Glyph="&#xE74D;"
                                        IsDestructive="True"
                                        Label="Excluir"
                                        Shortcut="Del" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="AUDITORIA" ShowSeparator="True">
                                <primitives:CadToolbarButton
                                    x:Name="ValidateCamToolbarBtn"
                                    Click="OnValidateToolbarClick"
                                    Glyph="&#xE73E;"
                                    Label="Revalidar SAT"
                                    Shortcut="F5"
                                    ShowLabel="True" />
                            </primitives:CadToolbarGroup>
                        </StackPanel>

                        <!-- Grupos Contextuais 3: ÁREA DE FABRICAÇÃO -->
                        <StackPanel
                            x:Name="ManufacturingRibbonGroups"
                            Orientation="Horizontal"
                            Spacing="0"
                            Visibility="Collapsed">
                            <primitives:CadToolbarGroup GroupLabel="ESCOPO DE SAÍDA" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="ScopeFullToolbarBtn"
                                        Click="OnExportScopeClick"
                                        Glyph="&#xF158;"
                                        Label="Full Box"
                                        Shortcut="Todas as chapas"
                                        ShowLabel="True"
                                        Tag="FullBox" />
                                    <primitives:CadToolbarButton
                                        x:Name="ScopeSingleToolbarBtn"
                                        Click="OnExportScopeClick"
                                        Glyph="&#xE8A5;"
                                        Label="Chapa 1:1"
                                        Shortcut="Apenas a chapa ativa"
                                        ShowLabel="True"
                                        Tag="PanelCombined" />
                                    <primitives:CadToolbarButton
                                        x:Name="ScopeEngraveToolbarBtn"
                                        Click="OnExportScopeClick"
                                        Glyph="&#xE932;"
                                        Label="Gravação"
                                        Shortcut="Somente gravação da chapa"
                                        ShowLabel="True"
                                        Tag="PanelEngraveOnly" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="CALIBRAÇÃO MDF" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="KerfSvgMfgToolbarBtn"
                                        Click="OnExportKerfSvgClick"
                                        Glyph="&#xE909;"
                                        Label="Pente SVG"
                                        Shortcut="Escolher local e exportar Pente SVG"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="KerfDxfMfgToolbarBtn"
                                        Click="OnExportKerfDxfClick"
                                        Glyph=""
                                        Label="Pente DXF"
                                        Shortcut="Escolher local e exportar Pente DXF"
                                        ShowLabel="True" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="MESA LASER / CNC" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ComboBox
                                        x:Name="ToolbarLaserBedCombo"
                                        Width="112"
                                        Height="24"
                                        DisplayMemberPath="ShortLabel"
                                        FontSize="10.5"
                                        SelectionChanged="OnToolbarLaserBedChanged"
                                        Style="{StaticResource CadComboBoxStyle}"
                                        ToolTipService.ToolTip="Área útil de corte da máquina Laser/CNC" />
                                    <Border
                                        x:Name="ToolbarLaserBedBadge"
                                        Height="20"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <TextBlock
                                            x:Name="ToolbarLaserBedBadgeText"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Text="600×400" />
                                    </Border>
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="EXPORTAÇÃO 1:1" ShowSeparator="True">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <primitives:CadToolbarButton
                                        x:Name="ExportSvgMfgToolbarBtn"
                                        Click="OnExportSvgToolbarClick"
                                        Glyph="&#xE898;"
                                        IsPrimary="True"
                                        Label="SVG 1:1"
                                        Shortcut="Exportar SVG 1:1"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="ExportDxfMfgToolbarBtn"
                                        Click="OnExportDxfToolbarClick"
                                        Glyph=""
                                        Label="DXF R2000"
                                        Shortcut="Exportar DXF R2000"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="ExportPdfMfgToolbarBtn"
                                        Click="OnExportPdfToolbarClick"
                                        Glyph=""
                                        Label="PDF 1:1"
                                        Shortcut="Exportar PDF 1:1"
                                        ShowLabel="True" />
                                    <primitives:CadToolbarButton
                                        x:Name="ExportZipMfgToolbarBtn"
                                        Click="OnExportZipToolbarClick"
                                        Glyph=""
                                        Label="ZIP"
                                        Shortcut="Exportar Pacote ZIP CNC"
                                        ShowLabel="True" />
                                </StackPanel>
                            </primitives:CadToolbarGroup>

                            <primitives:CadToolbarGroup GroupLabel="AUDITORIA" ShowSeparator="True">
                                <primitives:CadToolbarButton
                                    x:Name="ValidateToolbarBtn"
                                    Click="OnValidateToolbarClick"
                                    Glyph="&#xE73E;"
                                    Label="Revalidar CNC"
                                    Shortcut="F5"
                                    ShowLabel="True" />
                            </primitives:CadToolbarGroup>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Grupo Fixo Direita: LAYOUT & VISTAS -->
                <primitives:CadToolbarGroup
                    Grid.Column="1"
                    GroupLabel="LAYOUT &amp; VISTAS"
                    ShowSeparator="True">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <primitives:CadToolbarButton
                            x:Name="LeftPanelToolbarBtn"
                            Click="OnToggleLeftSidebarClick"
                            Glyph="&#xE8A0;"
                            Label="Painel Esquerdo"
                            Shortcut="F9" />
                        <primitives:CadToolbarButton
                            x:Name="View3DBtn"
                            Click="OnViewModeClick"
                            Glyph=""
                            Label="3D"
                            Shortcut="Somente Vista 3D"
                            ShowLabel="True"
                            Tag="Mode3D" />
                        <primitives:CadToolbarButton
                            x:Name="ViewSplitBtn"
                            Click="OnViewModeClick"
                            Glyph=""
                            Label="3D+2D"
                            Shortcut="Dividido 3D + Editor 2D"
                            ShowLabel="True"
                            Tag="Split" />
                        <primitives:CadToolbarButton
                            x:Name="View2DBtn"
                            Click="OnViewModeClick"
                            Glyph=""
                            Label="2D"
                            Shortcut="Somente Editor 2D"
                            ShowLabel="True"
                            Tag="Mode2D" />
                        <primitives:CadToolbarButton
                            x:Name="SplitVerticalBtn"
                            Click="OnSplitOrientationClick"
                            Glyph=""
                            Label="⬒ Vert"
                            Shortcut="Divisão vertical (3D em cima / 2D embaixo)"
                            ShowLabel="True"
                            Tag="VerticalStacked" />
                        <primitives:CadToolbarButton
                            x:Name="SplitHorizontalBtn"
                            Click="OnSplitOrientationClick"
                            Glyph=""
                            Label="◫ Lado"
                            Shortcut="Divisão lado a lado (3D à esquerda / 2D à direita)"
                            ShowLabel="True"
                            Tag="HorizontalSideBySide" />
                        <primitives:CadToolbarButton
                            x:Name="RightPanelToolbarBtn"
                            Click="OnToggleRightSidebarClick"
                            Glyph="&#xE89F;"
                            Label="Painel Direito"
                            Shortcut="F10" />
                    </StackPanel>
                </primitives:CadToolbarGroup>
            </Grid>
        </Border>

        <!-- Row 2: Conteúdo Split (Esquerda | Splitter | Centro | Splitter | Direita) -->
        <Grid x:Name="SplitGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="320" />
                <ColumnDefinition x:Name="LeftSplitterColDef" Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightSplitterColDef" Width="4" />
                <ColumnDefinition x:Name="RightColumnDef" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo -->
            <Border
                x:Name="LeftSidebarContainer"
                Grid.Column="0"
                Background="{ThemeResource CmPanelBackgroundBrush}"
                BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="26"
                        Padding="8,0,4,0"
                        Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LeftPanelTitleText"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                CharacterSpacing="50"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="PARÂMETROS DO PROJETO"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="CollapseLeftPanelBtn"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                MinHeight="20"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="OnToggleLeftSidebarClick"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                ToolTipService.ToolTip="Recolher Painel Esquerdo (F9)">
                                <TextBlock
                                    Margin="0,-2,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmTextPrimaryBrush}"
                                    Opacity="0.75"
                                    Text="‹" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <areas:ModelingAreaLeftPanel x:Name="ModelingLeftPanel" />
                        <areas:PersonalizationAreaLeftPanel x:Name="PersonalizationLeftPanel" Visibility="Collapsed" />
                        <areas:ManufacturingAreaLeftPanel x:Name="ManufacturingLeftPanel" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter Esquerdo -->
            <Border
                x:Name="LeftSplitterBar"
                Grid.Column="1"
                Background="{ThemeResource CmHairlineBorderBrush}"
                PointerMoved="OnLeftSplitterPointerMoved"
                PointerPressed="OnLeftSplitterPointerPressed"
                PointerReleased="OnLeftSplitterPointerReleased" />

            <!-- Viewport Central (Modelagem 3D superior / Divisor horizontal / Editor 2D inferior) -->
            <Grid
                x:Name="CenterViewportGrid"
                Grid.Column="2"
                Background="{ThemeResource CmViewportCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="Viewport3DRowDef" Height="*" />
                    <RowDefinition x:Name="ViewportSplitDividerRowDef" Height="0" />
                    <RowDefinition x:Name="Viewport2DRowDef" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Viewport3DColDef" Width="*" />
                    <ColumnDefinition x:Name="ViewportSplitDividerColDef" Width="0" />
                    <ColumnDefinition x:Name="Viewport2DColDef" Width="0" />
                </Grid.ColumnDefinitions>

                <controls:BoxViewer3DControl
                    x:Name="Viewer3D"
                    Grid.Row="0"
                    Grid.Column="0" />

                <Grid
                    x:Name="ViewportSplitDivider"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="Transparent"
                    DoubleTapped="OnViewportSplitDividerDoubleTapped"
                    PointerCanceled="OnViewportSplitDividerPointerLost"
                    PointerCaptureLost="OnViewportSplitDividerPointerLost"
                    PointerEntered="OnViewportSplitDividerPointerEntered"
                    PointerExited="OnViewportSplitDividerPointerExited"
                    PointerMoved="OnViewportSplitDividerPointerMoved"
                    PointerPressed="OnViewportSplitDividerPointerPressed"
                    PointerReleased="OnViewportSplitDividerPointerReleased"
                    ToolTipService.ToolTip="Arraste para redimensionar os viewports (duplo clique restaura 50% / 50%)"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ViewportSplitDividerHairline"
                        Background="{ThemeResource CmHairlineBorderBrush}" />
                </Grid>

                <controls:Surface2DEditorControl
                    x:Name="Editor2D"
                    Grid.Row="2"
                    Grid.Column="0" />
            </Grid>

            <!-- Splitter Direito -->
            <Border
                x:Name="RightSplitterBar"
                Grid.Column="3"
                Background="{ThemeResource CmHairlineBorderBrush}"
                PointerMoved="OnRightSplitterPointerMoved"
                PointerPressed="OnRightSplitterPointerPressed"
                PointerReleased="OnRightSplitterPointerReleased" />

            <!-- Painel Direito -->
            <Border
                x:Name="RightSidebarContainer"
                Grid.Column="4"
                Background="{ThemeResource CmPanelBackgroundBrush}"
                BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="26"
                        Padding="8,0,4,0"
                        Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="RightPanelTitleText"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                CharacterSpacing="50"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="RESUMO E PEÇAS"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="CollapseRightPanelBtn"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                MinWidth="20"
                                MinHeight="20"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="OnToggleRightSidebarClick"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                ToolTipService.ToolTip="Recolher Painel Direito (F10)">
                                <TextBlock
                                    Margin="0,-2,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmTextPrimaryBrush}"
                                    Opacity="0.75"
                                    Text="›" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <areas:ModelingAreaRightPanel x:Name="ModelingRightPanel" />
                        <areas:PersonalizationAreaRightPanel x:Name="PersonalizationRightPanel" Visibility="Collapsed" />
                        <areas:ManufacturingAreaRightPanel x:Name="ManufacturingRightPanel" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: Barra de Status Técnica Inferior (24 px) -->
        <Border
            Grid.Row="3"
            Height="24"
            Padding="8,0"
            Background="{ThemeResource CmShellBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Células à esquerda -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">

                    <StackPanel
                        x:Name="StatusStatePanel"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5"
                        ToolTipService.ToolTip="Pronto">
                        <Ellipse
                            x:Name="StatusStateDot"
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource CmStatusSuccessBrush}" />
                        <TextBlock
                            x:Name="StatusStateText"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                            Text="Pronto" />
                    </StackPanel>

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="UNID: mm (1:1)" />

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusModelText"
                        MaxWidth="260"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="MODELO: Caixa com Tampa e Alças"
                        TextTrimming="CharacterEllipsis" />

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusMaterialText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="MATERIAL: MDF 3.0 mm (Folga 0.00 mm)" />

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusDimensionsText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextPrimaryBrush}"
                        Text="DIM: 200 × 150 × 100 mm" />

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusPiecesText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="PEÇAS: 6 (1419.4 cm²)" />

                    <Rectangle Width="1" Height="12" VerticalAlignment="Center" Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusCamText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="CAM: 0 elem." />
                </StackPanel>

                <!-- Centro: Dica contextual do fluxo guiado (Etapas 1→2→3) -->
                <Grid
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle
                        Grid.Column="0"
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusGuidanceHintText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmUiFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="Etapa 1/3: ajuste dimensões, folga e tampa antes de personalizar."
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Direita: Status SAT CNC + Versão -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="StatusCncFeedbackText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource CmStatusSuccessBrush}"
                        Text="✓ Pronto para fabricação" />

                    <Rectangle
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource CmHairlineBorderBrush}" />

                    <TextBlock
                        x:Name="StatusVersionText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="v2.4.0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
