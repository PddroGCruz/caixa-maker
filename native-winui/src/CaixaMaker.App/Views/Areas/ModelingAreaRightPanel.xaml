<UserControl
    x:Class="CaixaMaker.App.Views.Areas.ModelingAreaRightPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cad="using:CaixaMaker.App.Controls.CadPrimitives">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Padding="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

            <!-- Seção 1: Diagnóstico Geométrico -->
            <cad:CadSectionPane Title="DIAGNÓSTICO GEOMÉTRICO">
                <StackPanel Spacing="6">
                    <cad:CadStatusBadge
                        x:Name="DiagnosticStatusBadge"
                        HorizontalAlignment="Left"
                        Kind="Valid"
                        Text="GEOMETRIA VÁLIDA 1:1" />

                    <StackPanel x:Name="ChecklistPanel" Spacing="4">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="CheckGeomDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CmStatusSuccessBrush}" />
                            <TextBlock
                                x:Name="CheckGeomText"
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{ThemeResource CmTextPrimaryBrush}"
                                Text="Parâmetros estruturais válidos para corte"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="CheckJointsDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CmAccentHighlightBrush}" />
                            <TextBlock
                                x:Name="CheckJointsText"
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="Encaixes finger joint balanceados"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="CheckKerfDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CmAccentHighlightBrush}" />
                            <TextBlock
                                x:Name="CheckKerfText"
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="Slot efetivo nominal"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </cad:CadSectionPane>

            <!-- Seção 2: Especificações Calculadas -->
            <cad:CadSectionPane Title="ESPECIFICAÇÕES CALCULADAS">
                <StackPanel Spacing="6">
                    <!-- Bloco comparativo 2 colunas -->
                    <Border
                        Padding="8,6"
                        Background="{ThemeResource CmInputBackgroundBrush}"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock
                                    x:Name="OuterMeasureTitleText"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmAccentHighlightBrush}"
                                    Text="EXTERNA · FIXA" />
                                <TextBlock
                                    x:Name="OuterMeasureValueText"
                                    FontFamily="{StaticResource CmMonoFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmAccentHighlightBrush}"
                                    Text="200 × 150 × 100" />
                                <TextBlock
                                    x:Name="OuterMeasureSubText"
                                    FontSize="10"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="mm nominais"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Rectangle
                                Grid.Column="1"
                                Width="1"
                                Fill="{ThemeResource CmHairlineBorderBrush}" />

                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock
                                    x:Name="InnerMeasureTitleText"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="INTERNA ÚTIL" />
                                <TextBlock
                                    x:Name="InnerMeasureValueText"
                                    FontFamily="{StaticResource CmMonoFontFamily}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmTextPrimaryBrush}"
                                    Text="194 × 144 × 97" />
                                <TextBlock
                                    x:Name="InnerMeasureSubText"
                                    FontSize="10"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="Livre após MDF"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabela de métricas de engenharia -->
                    <cad:CadMetricTable x:Name="EngineeringMetricsTable" />
                </StackPanel>
            </cad:CadSectionPane>

            <!-- Seção 3: Árvore de Chapas (Outliner) -->
            <cad:CadSectionPane
                x:Name="PartsTreeSection"
                BadgeText="0p"
                Title="ÁRVORE DE CHAPAS">
                <StackPanel x:Name="PartsTreeList" Spacing="2" />
            </cad:CadSectionPane>

            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé fixo do fluxo guiado (Etapa 1 -> Etapa 2/3) -->
        <Border
            Grid.Row="1"
            Padding="8,8"
            Background="{ThemeResource CmShellBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Spacing="5">
                <Button
                    x:Name="AdvanceToPersonalizationBtn"
                    Height="28"
                    HorizontalAlignment="Stretch"
                    Click="OnAdvanceToPersonalizationClick"
                    Content="Avançar para Personalização →"
                    Style="{StaticResource PrimaryAccentButtonStyle}"
                    ToolTipService.ToolTip="Prosseguir para a Etapa 2: Personalização CNC (Alt+2)" />

                <Button
                    x:Name="SkipToManufacturingBtn"
                    Height="24"
                    MinHeight="24"
                    HorizontalAlignment="Stretch"
                    Click="OnSkipToManufacturingClick"
                    Content="Pular direto para Fabricação »"
                    Style="{StaticResource CadSegmentedButtonStyle}"
                    ToolTipService.ToolTip="Ir direto para a Etapa 3: Fabricação e Exportação CAM (Alt+3)" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
