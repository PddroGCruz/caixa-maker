<UserControl
    x:Class="CaixaMaker.App.Views.CatalogHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CaixaMaker.App.Controls"
    xmlns:primitives="using:CaixaMaker.App.Controls.CadPrimitives"
    Background="{ThemeResource CmViewportCanvasBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Corpo Principal: Trilho Esquerdo (204 px) + Conteúdo Central -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Trilho Lateral Esquerdo Compacto -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CmPanelBackgroundBrush}"
                BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Identificação Própria do Produto (sem bloco branco pesado) -->
                    <Border
                        Grid.Row="0"
                        Padding="12,11"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/caixa-maker-symbol.png"
                                Stretch="Uniform" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmUiFontFamily}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CmTextPrimaryBrush}"
                                        Text="Caixa Maker" />
                                    <Border
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CmAccentSelectionBrush}"
                                        BorderBrush="{ThemeResource CmAccentSelectionBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CmControlCornerRadius}">
                                        <TextBlock
                                            x:Name="VersionBadgeText"
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CmAccentHighlightBrush}"
                                            Text="v2.4.0" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="CAD/CAM Paramétrico 1:1" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navegação Técnica -->
                    <ScrollViewer Grid.Row="1" Padding="6,10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="6,0,6,5"
                                CharacterSpacing="60"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="NAVEGAÇÃO" />

                            <Button
                                x:Name="NavHomeBtn"
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNavSectionClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                Tag="Home">
                                <Grid>
                                    <Border
                                        x:Name="NavHomeIndicator"
                                        Width="2"
                                        Margin="0,4"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource CmAccentHighlightBrush}" />
                                    <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource CmTextSecondaryBrush}" Glyph="&#xE80F;" />
                                        <TextBlock x:Name="NavHomeText" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource CmTextPrimaryBrush}" Text="Início" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="NavProjectsBtn"
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNavSectionClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                Tag="Projects">
                                <Grid>
                                    <Border
                                        x:Name="NavProjectsIndicator"
                                        Width="2"
                                        Margin="0,4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent" />
                                    <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource CmTextSecondaryBrush}" Glyph="&#xE8E5;" />
                                        <TextBlock x:Name="NavProjectsText" VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="Projetos Salvos" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="NavModelsBtn"
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnNavSectionClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                Tag="Models">
                                <Grid>
                                    <Border
                                        x:Name="NavModelsIndicator"
                                        Width="2"
                                        Margin="0,4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent" />
                                    <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource CmTextSecondaryBrush}" Glyph="&#xF158;" />
                                        <TextBlock x:Name="NavModelsText" VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="Modelos Paramétricos" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="NavNestingBtn"
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnOpenNestingFromCatalogClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                ToolTipService.ToolTip="Abrir Otimizador de Corte 2D (SVG / DXF / Nesting) — Alt+4">
                                <Grid>
                                    <Border
                                        Width="2"
                                        Margin="0,4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent" />
                                    <Grid Margin="10,0,6,0" VerticalAlignment="Center" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{ThemeResource CmAccentHighlightBrush}"
                                            Glyph="&#xE80A;" />
                                        <TextBlock
                                            x:Name="NavNestingText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                                            Text="Otimizador de Corte"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="2"
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource CmAccentSelectionBrush}"
                                            BorderBrush="{ThemeResource CmAccentHighlightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CmControlCornerRadius}">
                                            <TextBlock
                                                FontFamily="{StaticResource CmMonoFontFamily}"
                                                FontSize="8.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource CmAccentHighlightBrush}"
                                                Text="SVG/DXF" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Margin="6,6" Fill="{ThemeResource CmHairlineBorderBrush}" />

                            <Button
                                Height="38"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnImportPackageClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                ToolTipService.ToolTip="Importar projeto (.cmaker ou .caixamaker.json) (Ctrl+Shift+O)">
                                <Grid Margin="10,0,8,0" VerticalAlignment="Center" ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Glyph="&#xE896;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                                            Text="Importar Projeto"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="9.5"
                                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                                            Opacity="0.8"
                                            Text=".cmaker / legado"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                Height="30"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnOpenShortcutsClick"
                                CornerRadius="{StaticResource CmControlCornerRadius}"
                                ToolTipService.ToolTip="Abrir guia Sobre e Atalhos de Teclado (F1)">
                                <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" Foreground="{ThemeResource CmTextSecondaryBrush}" Glyph="&#xE765;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Text="Sobre &amp; Atalhos (F1)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé Institucional Técnico e Sóbro -->
                    <Border
                        Grid.Row="2"
                        Padding="10,10"
                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock
                                CharacterSpacing="60"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="VÍNCULO INSTITUCIONAL" />
                            <TextBlock
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextPrimaryBrush}"
                                Text="Laboratório IFMaker do Juruá" />
                            <TextBlock
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11"
                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                Text="IFAC — Campus Cruzeiro do Sul" />
                            <Button
                                Height="26"
                                Margin="0,6,0,0"
                                Padding="6,0"
                                HorizontalAlignment="Stretch"
                                Click="OnOpenInstitutionAboutClick"
                                FontSize="10.5"
                                Style="{StaticResource CadSecondaryButtonStyle}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Text="Sobre &amp; Identidade Institucional"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Área Central Estruturada -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra Superior do Catálogo (36 px) -->
                <Border
                    Grid.Row="0"
                    Padding="14,0"
                    Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="40"
                                FontFamily="{StaticResource CmUiFontFamily}"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CmTextPrimaryBrush}"
                                Text="CENTRAL DE PROJETOS E CATÁLOGO PARAMÉTRICO" />
                            <primitives:CadStatusBadge Kind="Valid" Text="Motor CAD/CAM Nativo Ativo" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <controls:CadThemeSwitcher x:Name="CatalogThemeSwitcher" />
                            <Rectangle Width="1" Height="16" Margin="2,0" Fill="{ThemeResource CmHairlineBorderBrush}" />
                            <Button
                                Height="24"
                                Padding="8,0"
                                Click="OnOpenPreferencesClick"
                                Content="Preferências"
                                FontSize="11"
                                Style="{StaticResource CompactToolbarButtonStyle}" />
                            <Button
                                Height="24"
                                Padding="8,0"
                                Click="OnOpenAboutClick"
                                Content="Sobre"
                                FontSize="11"
                                Style="{StaticResource CompactToolbarButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Área Principal de Conteúdo -->
                <ScrollViewer Grid.Row="1" Padding="14,12">
                    <StackPanel Spacing="10">
                        <!-- Faixa de Comando e Especificações Técnicas -->
                        <Border
                            Background="{ThemeResource CmPanelBackgroundBrush}"
                            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CmControlCornerRadius}">
                            <StackPanel Spacing="0">
                                <!-- Linha de Ações Principais -->
                                <Grid Padding="10,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Height="28"
                                            Padding="12,0"
                                            Click="OnQuickStartDefaultModelClick"
                                            Content="+ Novo Projeto (Tampa e Alças)"
                                            Style="{StaticResource PrimaryAccentButtonStyle}" />
                                        <Button
                                            Height="28"
                                            Click="OnQuickStartOpenBoxClick"
                                            Content="+ Caixa Aberta"
                                            Style="{StaticResource CadSecondaryButtonStyle}" />
                                        <Button
                                            Height="28"
                                            Click="OnOpenProjectsManagerClick"
                                            Content="Abrir Projeto Salvo..."
                                            Style="{StaticResource CadSecondaryButtonStyle}" />
                                        <Button
                                            Height="28"
                                            Click="OnImportPackageClick"
                                            Content="Importar Pacote..."
                                            Style="{StaticResource CadSecondaryButtonStyle}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmMonoFontFamily}"
                                        FontSize="11"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Text="Modelagem Finger Joint • CNC Laser / Router" />
                                </Grid>

                                <!-- Subfaixa Monoespaçada de Especificações (28 px) -->
                                <Border
                                    Height="28"
                                    Padding="10,0"
                                    Background="{ThemeResource CmShellBackgroundBrush}"
                                    BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                                            Text="UNIDADE: 1:1 (mm)" />
                                        <Rectangle Width="1" Height="14" Fill="{ThemeResource CmSubtleBorderBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{ThemeResource CmTextSecondaryBrush}"
                                            Text="EXPORTAÇÃO: SVG • DXF R2000 • PDF 1.4" />
                                        <Rectangle Width="1" Height="14" Fill="{ThemeResource CmSubtleBorderBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CmMonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{ThemeResource CmAccentHighlightBrush}"
                                            Text="MOTOR: Finger Joint + SAT" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cartão dedicado: Otimizador de Corte 2D (Nesting independente SVG/DXF) -->
                        <Border
                            Padding="12,9"
                            Background="{ThemeResource CmPanelBackgroundBrush}"
                            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CmControlCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource CmUiFontFamily}"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                                            Text="Otimizador de Corte (SVG / DXF)" />
                                        <primitives:CadStatusBadge Kind="Valid" Text="True-Shape 1:1" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Text="Organize arquivos SVG/DXF externos e aproveite retalhos de MDF" />
                                </StackPanel>

                                <Button
                                    x:Name="OpenNestingFromCatalogBtn"
                                    Grid.Column="1"
                                    Height="28"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CmAccentSelectionBrush}"
                                    BorderBrush="{ThemeResource CmAccentHighlightBrush}"
                                    BorderThickness="1"
                                    Click="OnOpenNestingFromCatalogClick"
                                    Content="Abrir Otimizador →"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmAccentHighlightBrush}"
                                    Style="{StaticResource CadSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Abrir Otimizador de Corte 2D (SVG / DXF / Nesting) — Alt+4" />
                            </Grid>
                        </Border>

                        <!-- Faixa Condicional de Rascunho Não Salvo (Height=36) -->
                        <Border
                            x:Name="DraftRecoveryBanner"
                            Height="36"
                            Padding="10,0"
                            Background="{ThemeResource CmStatusWarningSoftBrush}"
                            BorderBrush="{ThemeResource CmStatusWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CmControlCornerRadius}"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="13"
                                    Foreground="{ThemeResource CmStatusWarningBrush}"
                                    Glyph="&#xE7BA;" />

                                <TextBlock
                                    x:Name="DraftSummaryTextBlock"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource CmTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    Grid.Column="2"
                                    Height="24"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Click="OnDiscardDraftClick"
                                    Content="Descartar"
                                    FontSize="11"
                                    Style="{StaticResource CadSecondaryButtonStyle}" />

                                <Button
                                    Grid.Column="3"
                                    Height="24"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Click="OnRestoreDraftClick"
                                    Content="Restaurar Sessão"
                                    FontSize="11"
                                    Style="{StaticResource PrimaryAccentButtonStyle}" />
                            </Grid>
                        </Border>

                        <!-- Seção 1: MODELOS PARAMÉTRICOS DE CAIXAS (2 Colunas Simétricas) -->
                        <StackPanel x:Name="ModelsSectionPanel" Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    CharacterSpacing="60"
                                    FontFamily="{StaticResource CmUiFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="MODELOS PARAMÉTRICOS DE CAIXAS" />
                                <TextBlock
                                    x:Name="CatalogModelsCountText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CmMonoFontFamily}"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource CmTextSecondaryBrush}"
                                    Text="2 modelos disponíveis" />
                            </Grid>

                            <Grid x:Name="CatalogModelsGrid" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>

                        <!-- Seção 2: BIBLIOTECA DE PROJETOS (.CMAKER) (Tabela Técnica Compacta) -->
                        <StackPanel x:Name="SavedProjectsSectionPanel" Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        CharacterSpacing="60"
                                        FontFamily="{StaticResource CmUiFontFamily}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Text="BIBLIOTECA DE PROJETOS (.CMAKER)" />
                                    <TextBlock
                                        x:Name="SavedProjectsCountLabel"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource CmMonoFontFamily}"
                                        FontSize="10.5"
                                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                                        Text="(0)" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBox
                                        x:Name="ProjectsSearchBox"
                                        Width="184"
                                        Height="24"
                                        MinHeight="24"
                                        Padding="8,2"
                                        VerticalContentAlignment="Center"
                                        FontFamily="{StaticResource CmUiFontFamily}"
                                        FontSize="11"
                                        PlaceholderText="Buscar nome, tag, autor..."
                                        Style="{StaticResource CadTextBoxStyle}"
                                        TextChanged="OnProjectsSearchTextChanged" />
                                    <Button
                                        x:Name="MigrateLegacyProjectsBtn"
                                        Height="24"
                                        Padding="8,0"
                                        Click="OnMigrateLegacyProjectsClick"
                                        Content="Migrar Antigos"
                                        FontSize="11"
                                        Style="{StaticResource CadSecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Converter projetos legados .json da biblioteca local para o formato autocontido .cmaker"
                                        Visibility="Collapsed" />
                                    <Button
                                        Height="24"
                                        Padding="8,0"
                                        Click="OnImportPackageClick"
                                        Content="Importar .cmaker..."
                                        FontSize="11"
                                        Style="{StaticResource CadSecondaryButtonStyle}" />
                                    <Button
                                        Height="24"
                                        Padding="8,0"
                                        Click="OnOpenProjectsManagerClick"
                                        Content="Gerenciar..."
                                        FontSize="11"
                                        Style="{StaticResource CadSecondaryButtonStyle}" />
                                    <Button
                                        Height="24"
                                        Padding="8,0"
                                        Click="OnRefreshProjectsClick"
                                        Content="Atualizar"
                                        FontSize="11"
                                        Style="{StaticResource CadSecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Background="{ThemeResource CmPanelBackgroundBrush}"
                                BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CmControlCornerRadius}">
                                <StackPanel Spacing="0">
                                    <!-- Cabeçalho da Tabela (24 px) -->
                                    <Border
                                        Height="24"
                                        Padding="10,0"
                                        Background="{ThemeResource CmSectionHeaderBackgroundBrush}"
                                        BorderBrush="{ThemeResource CmHairlineBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="248" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="PROJETO E METADADOS" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="MODELO" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="DIMENSÕES (MM)" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="MATERIAL" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="ATUALIZADO EM" />
                                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CmTextSecondaryBrush}" Text="AÇÕES" />
                                        </Grid>
                                    </Border>

                                    <!-- Estado Vazio Compacto -->
                                    <Border
                                        x:Name="NoProjectsEmptyState"
                                        Height="38"
                                        Padding="10,0"
                                        Visibility="Collapsed">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource CmTextSecondaryBrush}"
                                                Text="Nenhum projeto encontrado na biblioteca local. Crie pelos modelos acima ou importe um arquivo .cmaker." />
                                            <Button
                                                Grid.Column="1"
                                                Height="24"
                                                Padding="9,0"
                                                VerticalAlignment="Center"
                                                Click="OnOpenProjectsManagerClick"
                                                Content="Gerenciar Biblioteca..."
                                                FontSize="11"
                                                Style="{StaticResource CadSecondaryButtonStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Linhas da Tabela -->
                                    <StackPanel x:Name="SavedProjectsRowsStack" Spacing="0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Barra de Status Inferior (Height=24) -->
        <Border
            Grid.Row="1"
            Height="24"
            Padding="10,0"
            Background="{ThemeResource CmShellBackgroundBrush}"
            BorderBrush="{ThemeResource CmHairlineBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource CmStatusSuccessBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CmMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{ThemeResource CmTextPrimaryBrush}"
                            Text="Pronto" />
                    </StackPanel>
                    <Rectangle Width="1" Height="13" Fill="{ThemeResource CmHairlineBorderBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="Unidades: milímetros (mm)" />
                    <Rectangle Width="1" Height="13" Fill="{ThemeResource CmHairlineBorderBrush}" />
                    <TextBlock
                        x:Name="CatalogStatusModelsText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="Catálogo: 2 modelos paramétricos" />
                    <Rectangle Width="1" Height="13" Fill="{ThemeResource CmHairlineBorderBrush}" />
                    <TextBlock
                        x:Name="CatalogStatusProjectsText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="Projetos locais: 0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmUiFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="IFMaker do Juruá • IFAC" />
                    <Rectangle Width="1" Height="13" Fill="{ThemeResource CmHairlineBorderBrush}" />
                    <TextBlock
                        x:Name="CatalogStatusVersionText"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CmMonoFontFamily}"
                        FontSize="10.5"
                        Foreground="{ThemeResource CmTextSecondaryBrush}"
                        Text="v2.4.0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
