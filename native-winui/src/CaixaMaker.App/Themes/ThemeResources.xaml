        <Setter Property="CornerRadius" Value="{StaticResource CmControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CmElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CmSubtleBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CmTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CmUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CmFontSizeBody}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
